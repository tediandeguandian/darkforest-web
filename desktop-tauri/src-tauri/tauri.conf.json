{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "黑暗森林",
  "version": "1.0.23",
  "identifier": "com.shuwang.darkforest",
  "build": {
    "frontendDist": "../www"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "三体 · 黑暗森林",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "center": true,
        "backgroundColor": "#0a0714"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese"
        ],
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-",
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    }
  }
}
